# Copy this file to .env and replace placeholders with real local values.
# Generate a random secret with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-this-with-a-random-64-character-hex-secret
ALGORITHM=HS256
# Short-lived access tokens; sessions continue via a rotating httpOnly refresh cookie.
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# Refresh cookie is Secure by default (browsers accept that on http://localhost).
# Set to false only for plain-HTTP testing on a non-localhost host.
# COOKIE_SECURE=true
# Public sign-up creates least-privileged "User" accounts; off by default.
# ALLOW_SELF_REGISTRATION=false
# Login brute-force protection (in-process; per account and per client IP).
# LOGIN_MAX_FAILURES=5
# LOGIN_LOCKOUT_MINUTES=15
# LOGIN_IP_MAX_ATTEMPTS=30
# LOGIN_IP_WINDOW_MINUTES=5
# Optional base64 32-byte Ed25519 seed for audit signatures; derived from SECRET_KEY if unset.
#   python -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
# AUDIT_SIGNING_KEY=
# Optional JSON array of browser origins. Defaults to localhost:3000 and 127.0.0.1:3000.
# CORS_ORIGINS=["http://localhost:3000"]

# Leave DATABASE_URL unset to use local SQLite.
# For PostgreSQL, create the database and user first:
# DATABASE_URL=postgresql://sentinel_user:replace-me@localhost:5432/sentinelai_db

# Optional: set all three unique passwords to create the starter roles on first startup.
# These values are only read when the corresponding account does not already exist.
SENTINEL_BOOTSTRAP_ADMIN_PASSWORD=
SENTINEL_BOOTSTRAP_ANALYST_PASSWORD=
SENTINEL_BOOTSTRAP_USER_PASSWORD=

# Optional absolute path to generated research results.
# RESEARCH_RESULTS_DIR=
