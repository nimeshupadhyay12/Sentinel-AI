# Copy this file to .env and replace placeholders with real local values.
# Generate a random secret with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-this-with-a-random-64-character-hex-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Optional JSON array of browser origins. Defaults to localhost:3000 and 127.0.0.1:3000.
# CORS_ORIGINS=["http://localhost:3000"]

# Leave DATABASE_URL unset to use local SQLite.
# For PostgreSQL, create the database and user first:
# DATABASE_URL=postgresql://sentinel_user:replace-me@localhost:5432/sentinelai_db

# Optional: set all three unique passwords to create the starter roles on first startup.
# These values are only read when the corresponding account does not already exist.
SENTINEL_BOOTSTRAP_ADMIN_PASSWORD=
SENTINEL_BOOTSTRAP_ANALYST_PASSWORD=
SENTINEL_BOOTSTRAP_USER_PASSWORD=

# Optional absolute path to generated research results.
# RESEARCH_RESULTS_DIR=
